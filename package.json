{
  "name": "forge",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI image studio for Mac",
  "workspaces": ["app", "tauri"],
  "scripts": {
    "dev": "cd tauri && npm run dev",
    "dev:server": "cd backend && python -m backend.main",
    "build": "npm run build:server && cd tauri && npm run build",
    "build:server": "bash scripts/build-server.sh",
    "setup:dev": "bash scripts/setup-dev-sidecar.sh"
  }
}
